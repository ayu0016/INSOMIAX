# Backend-only read-only PostgreSQL connection; replace locally, never commit credentials.
RADIX_SUPABASE_READONLY_DSN=postgresql://READ_ONLY_USER:REPLACE_ME@DB_HOST:5432/postgres?sslmode=require

# Required to validate a signed-in Supabase user's access token.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=REPLACE_WITH_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Optional when staging_company_skill_levels is not in a unique schema.
# Leave blank until the real schema has been inspected.
RADIX_STAGING_SCHEMA=

# Vite exposes only this non-secret API origin to the browser.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Comma-separated local frontend origins for FastAPI CORS.
RADIX_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Anonymous access applies to JD Analytics, Resume Parsing, Profile Builder, and
# Job Skill Matching only in explicit local development; Company Talent Check stays protected.
# Never enable this local mode in production.
RADIX_ENV=development
RADIX_JD_AUTH_MODE=local
RADIX_JD_MAX_UPLOAD_BYTES=10485760
# Optional JSON vocabulary file. Default vocabulary is explicitly illustrative.
# RADIX_JD_SKILL_VOCAB_PATH=backend/app/jd_analytics/skill_vocabulary.json
# Optional, separately reviewed mappings for Job Skill Matching. Default is empty.
# RADIX_MATCH_SKILL_MAPPINGS_PATH=backend/app/job_skill_matching/approved_mappings.json
